SECRET_KEY=change-me
FRONTEND_ORIGIN=http://localhost:5173

# Sin DATABASE_URL, el backend usa un archivo SQLite local (gestar.db) — no
# hace falta tener ningún servidor de base de datos corriendo para desarrollo.

# En producción (Render, etc.) seteá estas dos:
# DATABASE_URL=postgresql://user:password@host:port/dbname   (Render la inyecta sola)
# FLASK_ENV=production

# Asistente (HU15). Usa la primera opción configurada; sin ninguna, o si la IA
# falla, responde en modo básico (sin IA, gratis).
# Gemini, versión gratis (para demos; Google puede usar las conversaciones):
# se saca sin tarjeta en https://aistudio.google.com → Get API key.
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
# Claude (pago por uso): https://console.anthropic.com → API Keys.
# ANTHROPIC_API_KEY=sk-ant-...

# Mails con la contraseña al registrar y "Olvidé mi contraseña" (ver backend/mailer.py).
# Con Gmail: verificación en dos pasos activada y una "contraseña de aplicación"
# creada en https://myaccount.google.com/apppasswords
# SMTP_USER=la-cuenta@gmail.com
# SMTP_PASSWORD=contraseña-de-aplicación
# APP_URL=https://gestar-cyan.vercel.app
