SECRET_KEY=change-me
FRONTEND_ORIGIN=http://localhost:5173

# Sin DATABASE_URL, el backend usa un archivo SQLite local (gestar.db) — no
# hace falta tener ningún servidor de base de datos corriendo para desarrollo.

# En producción (Render, etc.) seteá estas dos:
# DATABASE_URL=postgresql://user:password@host:port/dbname   (Render la inyecta sola)
# FLASK_ENV=production
